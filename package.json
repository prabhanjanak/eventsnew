    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "catalog:",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pg": "8.20.0",
    "prettier": "^3.8.3",
    "tsx": "catalog:",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "drizzle-zod": "0.7.0"
  }
}
